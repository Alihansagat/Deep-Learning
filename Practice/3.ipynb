   ],
   "source": [
    "import numpy as np\n",
    "y = [0.0, 0.0, 0.0, 1.0]\n",
    "y_pred = [0.1, 0.2, 0.6, 0.1]\n",
    "\n",
    "def bce(y, y_pred, eps):\n",
    "    y_pred = np.clip(y_pred, eps, 1 - eps)\n",
    "    loss = -(y*np.log(y_pred)+(1-y)*np.log(1-y_pred))\n",
    "    return loss.mean()\n",
    "\n",
    "for i in range(len(y)):\n",
    "    print(bce(y[i], y_pred[i], 1e-7))"
   ]
  },
